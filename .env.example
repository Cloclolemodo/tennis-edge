# Copier ce fichier en `.env` et remplir les valeurs.
# Le `.env` ne doit JAMAIS être commit (déjà ignoré dans .gitignore).

ENVIRONMENT=development
DEBUG=true

# Base de données locale (déjà configurée par docker-compose)
DATABASE_URL=postgresql+psycopg://tennis:tennis@db:5432/tennis_edge

# Sources externes — à créer gratuitement :
# - api-sports.io (tennis) : https://api-sports.io
# - The Odds API (cotes)    : https://the-odds-api.com
API_SPORTS_KEY=
ODDS_API_KEY=
